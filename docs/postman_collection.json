{
  "info": {
    "name": "Peaje Inteligente - API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Variables: BASE_URL (https://tu-subdominio), TOKEN (lo llena \"auth/google\"), HARDWARE_TOKEN, INFERENCE_URL e INFERENCE_TOKEN (servidor de RunPod). Todas las rutas usan Bearer salvo auth/google."
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://peaje.tu-dominio.com"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "HARDWARE_TOKEN",
      "value": ""
    },
    {
      "key": "INFERENCE_URL",
      "value": "https://POD_ID-8000.proxy.runpod.net"
    },
    {
      "key": "INFERENCE_TOKEN",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "auth/google (id_token de Google)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/google",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            },
            "description": "Unica ruta publica. 403 si el correo no esta en la lista blanca.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"PEGA_AQUI_EL_ID_TOKEN\",\n  \"dispositivo\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"TOKEN\", pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "auth/yo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/yo",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "yo"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "auth/salir",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/salir",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "salir"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
