APP_NAME="Peaje Inteligente"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------- Peaje inteligente ----------------
# Endpoint unificado de inferencia (RunPod: https://<POD_ID>-8000.proxy.runpod.net | Colab: https://xxxx.trycloudflare.com)
INFERENCE_URL=
INFERENCE_TOKEN=
INFERENCE_TIMEOUT=30
PEAJE_CONFIANZA_MINIMA_OCR=0.40
PEAJE_VENTANA_DUPLICADOS=60

# Google OAuth 2.0 (console.cloud.google.com > APIs y servicios > Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
# IDs de cliente aceptados para el id_token de la app movil (Web client ID, separados por coma)
GOOGLE_CLIENT_IDS=

# Lista blanca inicial (el docente doc.alvaro.pinto.ma@unifranz.edu.bo siempre se crea como administrador)
ADMIN_EMAIL=tu-correo@gmail.com
OPERADOR_EMAIL=
SEED_ADMIN_EMAILS=
SEED_OPERADOR_EMAILS=

# Login de desarrollo sin Google: SOLO funciona con APP_ENV=local. Mantener en false en produccion.
AUTH_DEV_LOGIN=false

# Tiempo real (opcional). Sin estas claves el panel usa sondeo cada 3 s.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=sa1

# Hardware (ESP32 / Arduino)
HARDWARE_TOKEN=
HARDWARE_WEBHOOK_URL=

# Agente: los datos salen SIEMPRE de la BD; el LLM solo redacta. gemini | anthropic | ninguno
AGENTE_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-opus-5-5
