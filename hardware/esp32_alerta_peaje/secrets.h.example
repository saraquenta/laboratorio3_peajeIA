// Copia este archivo como "secrets.h" (esta en .gitignore: NO se sube al repositorio) y completa tus datos.
#pragma once

// Red Wi-Fi de 2.4 GHz (el ESP32 no se conecta a 5 GHz). Sirve el hotspot del celular.
#define WIFI_SSID      "TU_WIFI"
#define WIFI_PASSWORD  "TU_CLAVE_WIFI"

// Dominio de la web en la nube, SIN https:// ni barra final (p. ej. peaje-ia.onrender.com o peaje.tu-dominio.com)
#define API_HOST       "peaje.tu-dominio.com"

// El mismo valor de HARDWARE_TOKEN del .env de la web
#define HARDWARE_TOKEN "pega_aqui_el_HARDWARE_TOKEN"

// ID de la caseta que vigila este ESP32 (Administración -> Casetas en el panel)
#define CASETA_ID      1

// Opcional: certificado raiz del dominio (PEM) para validar HTTPS. Vacio = sin validar (solo para la demo).
// Obtenlo con: openssl s_client -showcerts -connect peaje.tu-dominio.com:443
#define ROOT_CA ""
