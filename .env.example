# =====================================================================================
#  Peaje Inteligente — variables de entorno de TODOS los servicios (referencia).
#  Cada servicio lee su propio archivo:  web/.env  (copia de web/.env.example),
#  variables del Pod de RunPod / Colab, y --dart-define de la app móvil.
#  NUNCA subas archivos .env reales, tokens ni client_secret al repositorio.
# =====================================================================================

# ---------- web/.env (Laravel) ----------
APP_NAME="Peaje Inteligente"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://peaje.tu-dominio.com
APP_TIMEZONE=America/La_Paz
APP_KEY=                                   # php artisan key:generate

DB_CONNECTION=mysql
DB_HOST=localhost                          # el MySQL del propio hosting
DB_PORT=3306
DB_DATABASE=peaje
DB_USERNAME=peaje_user
DB_PASSWORD=

SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=public

# Endpoint unificado de inferencia (RunPod o Colab) — también editable en la página Estado
INFERENCE_URL=https://POD_ID-8000.proxy.runpod.net
INFERENCE_TOKEN=                           # = API_TOKEN del Pod
INFERENCE_TIMEOUT=30
PEAJE_CONFIANZA_MINIMA_OCR=0.40
PEAJE_VENTANA_DUPLICADOS=60

# Google OAuth 2.0
GOOGLE_CLIENT_ID=XXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=                      # solo en el servidor
GOOGLE_REDIRECT_URI=/auth/google/callback
GOOGLE_CLIENT_IDS=XXXX.apps.googleusercontent.com

# Lista blanca (doc.alvaro.pinto.ma@unifranz.edu.bo ya se crea como administrador)
ADMIN_EMAIL=tu-correo@gmail.com
OPERADOR_EMAIL=
SEED_ADMIN_EMAILS=
SEED_OPERADOR_EMAILS=
AUTH_DEV_LOGIN=false

# Tiempo real (opcional, sin esto el panel sondea cada 3 s)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=sa1

# Hardware
HARDWARE_TOKEN=
HARDWARE_WEBHOOK_URL=

# Agente: gemini (por defecto) | anthropic | ninguno
AGENTE_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-opus-5-5

# ---------- Pod de RunPod / Colab (inferencia) ----------
API_TOKEN=                                 # token largo; copiarlo a INFERENCE_TOKEN
INFERENCE_MODE=real                        # real | mock (mock solo para pruebas sin GPU)
PORT=8000
# PASAJEROS_WEIGHTS=/workspace/peaje/inferencia/pesos/pasajeros_seg.pt
# PLACAS_WEIGHTS=/workspace/peaje/inferencia/pesos/placas_yolo.pt
# VEHICULOS_WEIGHTS=/workspace/peaje/inferencia/pesos/vehiculos_seg.pt
# LLANTAS_WEIGHTS=/workspace/peaje/inferencia/pesos/llantas_pose.pt
# YOLOE_WEIGHTS=yoloe-11l-seg.pt
# PERSONAS_WEIGHTS=yolo11s-seg.pt
# IMGSZ=960

# ---------- App móvil (flutter build ... --dart-define=) ----------
# API_BASE_URL=https://peaje.tu-dominio.com
# GOOGLE_SERVER_CLIENT_ID=XXXX.apps.googleusercontent.com

# ---------- ESP32 (hardware/esp32_alerta_peaje/secrets.h, NO se sube) ----------
# WIFI_SSID / WIFI_PASSWORD / API_HOST (sin https://) / HARDWARE_TOKEN / CASETA_ID

# ---------- Entrenamiento (Secretos de Colab, NO en el notebook) ----------
# ROBOFLOW_API_KEY=
